# Copy this file to .env and fill in your keys.

# OpenAI — required for gpt-image-1, gpt-image-1.5
OPENAI_API_KEY=sk-proj-…
# Google Gemini — required for gemini-* models
GOOGLE_API_KEY=AI…
# QuiverAI — required for vectorization, get one here: https://app.quiver.ai/settings/api-keys
QUIVER_API_KEY=sk_…
